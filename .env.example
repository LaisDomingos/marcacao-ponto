# ─────────────────────────────────────────────────────────────
# Supabase (acesso no SERVIDOR). Pegue em: Project Settings > API.
# ─────────────────────────────────────────────────────────────
# Use a URL BASE do projeto, SEM "/rest/v1" no final — o cliente adiciona o
# caminho da API sozinho. Ex.: https://abcdefgh.supabase.co
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave service_role (secreta) — ignora o RLS e só deve ser usada no servidor.
# NUNCA exponha no navegador nem versione este valor.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Obs.: o upload de logo usa o Supabase Storage, no bucket público "logos",
# criado automaticamente na primeira logo enviada. Nenhuma variável extra.

# ─────────────────────────────────────────────────────────────
# Sessão do administrador
# ─────────────────────────────────────────────────────────────
# Segredo para assinar os cookies de sessão. Use uma string aleatória com
# pelo menos 32 caracteres em produção.
SESSION_SECRET=troque-este-segredo-por-uma-string-aleatoria-de-32-chars

# ─────────────────────────────────────────────────────────────
# Empresa de demonstração (criada apenas pelo `npm run seed`)
# ─────────────────────────────────────────────────────────────
# Não é usado em produção — serve só para o admin da empresa "demo".
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=admin123

# ─────────────────────────────────────────────────────────────
# Fuso horário usado para datas/horários das marcações
# ─────────────────────────────────────────────────────────────
TZ=Europe/Lisbon
